service dumbosd /system/bin/dumbosd-wrapper.sh
    class late_start
    user root
    group root

service dumbos-firewall /system/bin/dumbos-firewall-init.sh
    class late_start
    user root
    group root
    oneshot

service dumbos-log-upload /system/bin/dumbos-log-upload.sh
    class late_start
    user root
    group root
    restart_period 3600
    disabled

service setpin /system/bin/setpin.sh
    class late_start
    user root
    group root
    oneshot
    disabled

service sing-box /system/bin/sing-box-wrapper.sh
    class late_start
    user root
    group root
    disabled

on property:sys.boot_completed=1
  mkdir /data/local/tmp/dumb 0700 root root
  chmod 0600 /mnt/vendor/persist/dumbos_user
  copy /mnt/vendor/persist/dumbos_user /dev/dumbos-userdata
  start setpin
  start sing-box
  start dumbos-log-upload

# see also:daemon/command.c
# mkdir: emulator compatibility
on property:dumbos.newuser=1
  chmod 0600 /dev/dumbos-userdata-new
  mkdir /mnt/vendor/persist 0700 root root
  copy /dev/dumbos-userdata-new /mnt/vendor/persist/dumbos_user
  copy /dev/dumbos-userdata-new /dev/dumbos-userdata
