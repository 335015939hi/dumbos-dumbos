cc_binary {
    name: "dumbos",

    srcs: [
        "caller/main.c",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
    product_specific: true,

}



cc_binary {
    name: "dumbosd",

    srcs: [
        "daemon/main.c",
        "daemon/daemon.c",
        "common.c",
    ],


    cflags: [
        "-Wall",
        "-Werror",
    ],
    product_specific: true,

}
