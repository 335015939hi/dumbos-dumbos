cc_binary {
    name: "dumbos",

    srcs: [
        "caller/main.c",
        "caller/client.c",
        "common.c",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

}



cc_binary {
    name: "dumbosd",

    srcs: [
        "daemon/main.c",
        "daemon/daemon.c",
        "daemon/handler.c",
        "daemon/command.c",
        "daemon/secret_code.c",
        "daemon/util.c",
        "daemon/curl.c",
        "dumbpayload.c",
        "common.c",
        "ed25519.c",
    ],
    
    shared_libs: [
        "libcrypto",
        "libcurl",
        "liblog",
        "libselinux",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    init_rc:[
      "dumbosd.rc",
    ]

}

sh_binary {
    name:"dumbos-firewall.sh",
    src:"firewall/dumbos-firewall.sh"
}

sh_binary {
    name:"dumbos-firewall-init.sh",
    src:"firewall/dumbos-firewall-init.sh"
}

sh_binary {
    name:"dumbos-firewallctl.sh",
    src:"firewall/dumbos-firewallctl.sh"
}

prebuilt_etc {
    name: "dumbos-firewall.conf",
    src: "firewall/dumbos-firewall.conf",
    filename: "dumbos-firewall.conf",
}
