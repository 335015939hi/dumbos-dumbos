cc_binary {
    name: "dumbos",

    srcs: [
        "caller/main.c",
        "common.c",
        "caller/client.c",

    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
    product_specific: true,

}



cc_binary {
    name: "dumbosd",

    srcs: [
        "daemon/main.c",
        "daemon/daemon.c",
        "common.c",
        "daemon/handler.c",
        "daemon/command.c",
        "daemon/secret_code.c",
        "daemon/util.c"
    ],
    
    shared_libs: [
        "libcrypto",
        "libcurl",
        "libpthread",
        "liblog",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
    product_specific: true,

}
