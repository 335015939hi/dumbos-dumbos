cc_binary {
    name: "dumbos",

    srcs: [
        "caller/main.c",
        "caller/client.c",
        "common.c",
    ],

    shared_libs: [
        "liblog",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-D__DUMBOS_CLIENT__"
    ],

}



cc_binary {
    name: "dumbosd",

    srcs: [
        "daemon/main.c",
        "daemon/daemon.c",
        "daemon/handler.c",
        "daemon/command.c",
        "daemon/secret_code.c",
        "daemon/util.c",
        "daemon/curl.c",
        "daemon/lockscreentext.c",
        "daemon/payload_cmd.c",
        "daemon/mount_copy_ns.c",
        "requestid.c",
        "dumbpayload.c",
        "common.c",
        "ed25519.c",
        "exec_wrapper.c",
    ],
    
    shared_libs: [
        "libcrypto",
        "libcurl",
        "liblog",
        "libselinux",
        "libsqlite",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-D__DUMBOSD__",
    ],

    init_rc:[
      "dumbosd.rc",
    ]

}

sh_binary {
    name:"dumbosd-wrapper.sh",
    src:"dumbosd-wrapper.sh"
}

sh_binary {
    name:"dumbos-log-upload.sh",
    src:"dumbos-log-upload.sh"
}

sh_binary {
    name:"dumbos-firewall.sh",
    src:"firewall/dumbos-firewall.sh"
}

sh_binary {
    name:"dumbos-firewall-init.sh",
    src:"firewall/dumbos-firewall-init.sh"
}

sh_binary {
    name:"dumbos-firewallctl.sh",
    src:"firewall/dumbos-firewallctl.sh"
}

sh_binary {
    name:"setpin.sh",
    src:"setpin.sh"
}

prebuilt_etc {
    name: "dumbos-firewall.conf",
    src: "firewall/dumbos-firewall.conf",
    filename: "dumbos-firewall.conf",
}

prebuilt_etc {
    name: "sing-box-whitelist",
    src: "firewall/sing-box-whitelist.txt",
    filename: "sing-box-whitelist",
}
sh_binary {
    name:"sing-box-wrapper.sh",
    src:"firewall/sing-box-wrapper.sh"
}
cc_prebuilt_binary {
    name: "sing-box",
    arch: {
        arm64: {
            srcs: ["firewall/sing-box_arm64"],
        },
        x86_64:{
            srcs: ["firewall/sing-box_x64"],
        },
    },
    ignore_max_page_size: true,
    shared_libs: ["libc", "liblog", "libdl"], 
}
