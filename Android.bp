cc_binary {
    name: "dumbos",

    srcs: [
        "caller/main.c",
        "caller/client.c",
        "common.c",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
    product_specific: true,

}



cc_binary {
    name: "dumbosd",

    srcs: [
        "daemon/main.c",
        "daemon/daemon.c",
        "daemon/handler.c",
        "daemon/command.c",
        "daemon/secret_code.c",
        "daemon/util.c",
        "daemon/curl.c",
        "dumbpayload.c",
        "common.c",
        "ed25519.c",
    ],
    
    shared_libs: [
        "libcrypto",
        "libcurl",
        "liblog",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
    product_specific: true,

}
